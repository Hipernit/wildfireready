# Copy to .env.local (git-ignored) and fill in.
# EXPO_PUBLIC_* values are inlined into the client bundle and are readable by
# anyone with the app. Do not put secrets here.

# Free key from https://docs.airnowapi.org/account/request/
EXPO_PUBLIC_AIRNOW_API_KEY=

# api.weather.gov asks for an identifying User-Agent with contact info.
EXPO_PUBLIC_NWS_UA=WildfireReady (you@example.com)

# Development builds only: set to 1 to show labeled DEMO data when live
# sources are unreachable and nothing is cached.
EXPO_PUBLIC_DEMO_MODE=0
